rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGrantedViewer(ownerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/viewerGrants/$(ownerId)/viewers/$(request.auth.uid));
    }

    match /categories/{categoryId} {
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow get:    if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
      allow list:   if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
    }

    match /transactions/{transactionId} {
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow get:    if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
      allow list:   if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
    }

    match /investments/{investmentId} {
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow get:    if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
      allow list:   if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
    }

    match /debts/{debtId} {
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow get:    if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
      allow list:   if isSignedIn() && (resource.data.userId == request.auth.uid || isGrantedViewer(resource.data.userId));
    }

    match /userBalances/{userId} {
      allow read:  if isSignedIn() && (request.auth.uid == userId || isGrantedViewer(userId));
      allow write: if isOwner(userId);
    }

    match /shareTokens/{tokenId} {
      allow read:   if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /viewerGrants/{ownerId}/viewers/{viewerId} {
      allow read:   if isSignedIn() && (request.auth.uid == ownerId || request.auth.uid == viewerId);
      allow create: if isSignedIn()
        && request.auth.uid == viewerId
        && request.resource.data.viewerId == viewerId
        && request.resource.data.ownerId == ownerId
        && exists(/databases/$(database)/documents/shareTokens/$(request.resource.data.tokenId))
        && get(/databases/$(database)/documents/shareTokens/$(request.resource.data.tokenId)).data.ownerId == ownerId
        && get(/databases/$(database)/documents/shareTokens/$(request.resource.data.tokenId)).data.active == true;
      allow delete: if isSignedIn() && (request.auth.uid == ownerId || request.auth.uid == viewerId);
      allow update: if false;
    }
  }
}
